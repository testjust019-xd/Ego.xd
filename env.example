# Copie en .env et remplis les valeurs

PORT=3000

# URL publique (VPS = http://IP:3000 | Render = https://xxx.onrender.com)
PUBLIC_URL=

# Session principale : code pairing au lieu du QR
PAIRING_ENABLED=false
PAIRING_PHONE=2250xxxxxxxxx

# Dossier sessions (sur VPS laisse sessions ; Render disk = /app/sessions)
SESSION_DIR=sessions

# Optionnel
# ADMIN_TOKEN=change-moi
# KEEPALIVE=1
# BAILEYS_LOG_LEVEL=error
# GROQ_API_KEY=
# ELEVENLABS_API_KEY=

# ─── Hébergement de fichiers via Telegram (/f/:id) ───
# Token du bot dédié au stockage (peut être un bot différent du bot principal)
# TG_STORAGE_BOT_TOKEN=
# chat_id du channel/groupe privé où les fichiers sont envoyés
# TG_STORAGE_CHAT_ID=
# Laisse vide = API standard (50MB max). Mets l'URL de ton Local Bot API
# Server (ex: http://localhost:8081) pour monter jusqu'à ~2GB.
# TG_API_BASE=
# TG_MAX_UPLOAD_MB=45

